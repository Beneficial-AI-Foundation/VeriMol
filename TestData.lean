  ("two atoms with an orientation, in increasing order", some "the Mol is not sound: the bonds and hydrogens of atom 1 add up to no usual valence of its element", some []),
  ("two atoms with an orientation, not in increasing order", some "the Mol is not well formed", none),
  ("one atom with two orientations", some "the Mol is not well formed", none),
  ("a double bond with a geometry, with one other neighbour at each of its atoms", none, some []),
  ("a double bond with a geometry, with two other neighbours at each of its atoms", none, some []),
  ("a geometry at a single bond", some "the Mol is not well formed", none),
  ("a geometry at a double bond one of whose atoms has no other neighbour", some "the Mol is not well formed", none),
  ("a geometry at a double bond one of whose atoms has three other neighbours", some "the Mol is not well formed", none),
  ("a geometry whose two atoms are given with the larger number first", some "the Mol is not well formed", none),
  ("a geometry at two atoms that are not bonded", some "the Mol is not well formed", none),
  ("two double bonds with a geometry, in the order of the bonds", none, some []),
  ("two double bonds with a geometry, not in the order of the bonds", some "the Mol is not well formed", none)
]

/-- Part 2 of 2 of `filters`. -/
def filtersPart2 : List (String × Option String × Option (List (List Nat))) := [
  ("one double bond with two geometries", some "the Mol is not well formed", none),
  ("an atom with an orientation at a double bond with a geometry", none, some []),
  ("a stereo centre with a free place as atom 0: every spelling would write it without an atom before it", none, some []),
  ("a stereo centre with a free place and three single bonds, between its neighbours in the numbering: the plain spelling would write it with one ring number, the spelling with round brackets writes it", none, some []),
  ("a double bond with a geometry at an atom whose only other bond is a double bond: no bond can carry a mark", none, some []),
  ("three double bonds in a chain, the first and the last with a geometry: the marks would give the middle one a geometry as well", none, some []),
  ("a ring of four double bonds and four single bonds, as in C/1=C/C=C\\C=C/C=C\\1, with the geometry of the first double bond turned round: no choice of marks gives every geometry", none, some [])
]

/-- What the filter asks of a `Mol`, for each `Mol` of `mols`, in the same order
(SPEC.md, section 16). Each entry holds the name of the `Mol` and two answers
of the model:

* the first reason why the `Mol` is not sound, or `none` if it is sound
  (section 16.2);
* its perfluorinated groups, each as the list of its atoms in increasing
  order, in the order of the lowest atom of each group (section 16.3). `none`
  for a `Mol` that is not well formed: the groups are defined for a well
  formed `Mol`. -/
def filters : List (String × Option String × Option (List (List Nat))) :=
  filtersPart1 ++ filtersPart2

